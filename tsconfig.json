{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "lib": ["ES2018", "DOM", "ESNext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "paths": {
      "vuex": ["./node_modules/vuex/types"], // fix vuex pnpm issue
    }
  },
  "include": ["index.d.ts"]
}
